# My Place - Environment Variables Template
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to version control

# =============================================================================
# SUPABASE
# =============================================================================
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key (server-side only, NEVER expose to client)
# Used for admin operations and bypassing RLS
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Project ref (for CLI and type generation)
SUPABASE_PROJECT_ID=your-project-ref

# =============================================================================
# SMILE IDENTITY (ID Verification)
# =============================================================================
# Get these from: https://portal.usesmileid.com/
# Docs: https://docs.usesmileid.com/

# Partner ID (public, can be exposed)
NEXT_PUBLIC_SMILE_ID_PARTNER_ID=your-partner-id

# API Key (server-side only, NEVER expose to client)
SMILE_ID_API_KEY=your-api-key-here

# Environment: 'sandbox' for testing, 'production' for live
SMILE_ID_ENVIRONMENT=sandbox

# Webhook callback URL (where Smile ID sends verification results)
# For local dev: use ngrok or similar tunnel
# For production: https://yourdomain.com/api/webhooks/smile-id
SMILE_ID_CALLBACK_URL=https://your-ngrok-url.ngrok.io/api/webhooks/smile-id

# =============================================================================
# GOOGLE MAPS PLATFORM
# =============================================================================
# Get from: https://console.cloud.google.com/google/maps-apis
# Enable: Maps JavaScript API, Geocoding API, Geolocation API

# API Key (public, with domain/IP restrictions in production)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# =============================================================================
# TERMII (SMS/OTP Provider)
# =============================================================================
# Get from: https://accounts.termii.com/
# Docs: https://developer.termii.com/

# API Key (server-side only)
TERMII_API_KEY=your-termii-api-key

# Sender ID (must be registered with Termii)
# Format: alphanumeric, max 11 characters
TERMII_SENDER_ID=MyPlace

# =============================================================================
# RESEND (Email Provider - Optional for Phase 1)
# =============================================================================
# Get from: https://resend.com/api-keys
# Used for transactional emails (verification, booking notifications)

RESEND_API_KEY=your-resend-api-key

# From email (must be verified domain in Resend)
RESEND_FROM_EMAIL=noreply@yourdomain.com

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# App URL (used for OAuth redirects, webhook URLs, etc.)
# Local dev: http://localhost:3000
# Production: https://yourdomain.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Commission rate default (as decimal: 0.07 = 7%)
# Current working placeholder: 6-8% range, using 7% midpoint
COMMISSION_RATE_DEFAULT=0.07

# ID document retention period (days)
# Per NDPR compliance: short retention for ID images
ID_DOCUMENT_RETENTION_DAYS=30

# =============================================================================
# DEVELOPMENT / DEBUGGING (Optional)
# =============================================================================

# Enable detailed logging in development
DEBUG=false

# Disable ID verification in local dev (bypass for testing)
# WARNING: Never enable in production
DISABLE_ID_VERIFICATION_GATE=false

# =============================================================================
# NOTES FOR SETUP
# =============================================================================
# 
# 1. SUPABASE SETUP:
#    - Create project at supabase.com
#    - Run migrations from supabase/migrations/
#    - Enable PostGIS extension in Database > Extensions
#    - Generate types: npm run db:types
#
# 2. SMILE IDENTITY SETUP:
#    - Sign up at usesmileid.com
#    - Start with sandbox environment
#    - Set up webhook endpoint (use ngrok for local dev)
#    - Test with sandbox credentials before going live
#
# 3. GOOGLE MAPS SETUP:
#    - Create project in Google Cloud Console
#    - Enable required APIs (see above)
#    - Set up billing (free $200/month credit)
#    - Restrict API key by domain/IP in production
#
# 4. TERMII SETUP:
#    - Sign up at termii.com
#    - Register sender ID (approval required)
#    - Fund account (pay-as-you-go)
#    - Test with Nigerian phone numbers
#
# 5. SECURITY:
#    - Never commit .env.local to git (already in .gitignore)
#    - Rotate API keys regularly
#    - Use environment-specific keys (dev vs production)
#    - Enable domain restrictions on public API keys
#
